# ─── Required ──────────────────────────────────────────────────────
# Anthropic API Key (for Claude agent)
ANTHROPIC_API_KEY=sk-ant-...

# ─── E2B Sandbox (Recommended for production) ─────────────────────
# Without this key, agent tools (Bash/Read/Write) run on the host — unsafe for multi-user.
# Get your key at: https://e2b.dev/dashboard
E2B_API_KEY=e2b_...

# ─── Optional ─────────────────────────────────────────────────────
# Server port (default: 3001)
# PORT=3001

# Sandbox provider (default: e2b)
# SANDBOX_PROVIDER=e2b

# E2B sandbox template (default: base)
# SANDBOX_TEMPLATE=base

# Sandbox timeout in ms (default: 300000 = 5 min)
# SANDBOX_TIMEOUT=300000

# Idle sandbox auto-destroy timeout in ms (default: 600000 = 10 min)
# SANDBOX_IDLE_TIMEOUT=600000

# ─── Optional: MCP / OAuth ───────────────────────────────────────
# Craft MCP Server
# CRAFT_MCP_URL=http://localhost:3000/v1/links/YOUR_SECRET_LINK_ID/mcp
# CRAFT_MCP_TOKEN=your-bearer-token

# Slack OAuth
# SLACK_OAUTH_CLIENT_ID=
# SLACK_OAUTH_CLIENT_SECRET=

# Microsoft OAuth
# MICROSOFT_OAUTH_CLIENT_ID=
